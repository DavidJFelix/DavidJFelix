# Claude likes to create worktrees when using code locally
.claude/worktrees

/target
.DS_Store
node_modules/

# Warden local run artifacts (logs, sessions, cached findings)
.warden/

# Pi local packages/sessions; keep the project settings tracked.
.pi/*
!.pi/settings.json

# Turborepo run logs and daemon state; never inputs, never committed.
.turbo/

# JUnit reports written for Depot CI's test results view (mise run spell:ci).
/test-results/
