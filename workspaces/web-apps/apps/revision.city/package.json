{
  "name": "@davidjfelix/revision.city",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3005",
    "prepare": "panda codegen",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@davidjfelix/og": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/common": "1.5.2",
    "@lezer/cpp": "1.1.6",
    "@lezer/css": "1.3.6",
    "@lezer/go": "1.0.1",
    "@lezer/highlight": "1.2.3",
    "@lezer/html": "1.3.13",
    "@lezer/java": "1.1.3",
    "@lezer/javascript": "1.5.4",
    "@lezer/json": "1.0.3",
    "@lezer/lezer": "1.1.3",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@lezer/php": "1.0.5",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.2",
    "@lezer/sass": "1.1.0",
    "@lezer/xml": "1.0.6",
    "@lezer/yaml": "1.0.4",
    "@pierre/diffs": "1.3.5",
    "@pierre/icons": "0.7.1",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@sentry/cloudflare": "^10.60.0",
    "@sentry/react": "^10.60.0",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "lucide-react": "1.33.0",
    "posthog-js": "^1.393.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260819.1",
    "@pandacss/dev": "1.12.0",
    "@playwright/test": "1.62.1",
    "@tanstack/devtools-vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
