{
  "name": "@davidjfelix/harness-opencode",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "smoke": "bun bin/smoke.ts",
    "deploy": "wrangler deploy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@opencode/sdk": "2.2.7",
    "agents": "0.33.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.158.0"
  }
}
