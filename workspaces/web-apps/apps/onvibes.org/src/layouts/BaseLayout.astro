---
import {ogTags} from '@davidjfelix/og'
import {createThemeBootstrapScript} from '@davidjfelix/theme/bootstrap'
import {css} from 'styled-system/css'
import Analytics from '../components/Analytics.astro'
import '../index.css'

// Shared document shell: head boilerplate, the Panda base stylesheet, and
// analytics wiring live here so every page gets them and head changes happen
// once. `bodyClass` lets a page keep styling the <body> itself (index.astro's
// layout styles live there); `bodyBase` is the theme-aware default every page
// gets regardless (chat.astro passes no bodyClass of its own).
interface Props {
  title: string
  description: string
  bodyClass?: string
}
const {title, description, bodyClass} = Astro.props

// Only ship analytics on builds that carry the key (production deploy). Sentry
// is injected separately by the @sentry/astro integration when
// PUBLIC_SENTRY_DSN is set. Both stay off locally/CI/preview.
const posthogEnabled = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY)

const bodyBase = css({bg: 'bg.canvas', color: 'text'})

// Stringified at build time into the pre-paint inline script -- the only code
// that can run before first paint.
const themeBootstrapScript = createThemeBootstrapScript({storageKey: 'theme'})
---

<html lang="en">
  <head>
    <!--
      Pre-paint theme bootstrap: applies the persisted (or OS) color scheme to
      <html> before first paint so the page never flashes the wrong scheme.
      Generated at build time from @davidjfelix/theme's typed bootstrap
      (packages/theme/src/bootstrap.ts). Contract:
      docs/projects/theme-switcher-unification/plan.md. Kept current after
      load by src/components/theme-toggle.astro.
    -->
    <script is:inline set:html={themeBootstrapScript} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {/* OpenGraph/Twitter pairs shared through @davidjfelix/og. */}
    {ogTags({title, description, type: 'website', siteName: 'onvibes.org'}).map((tag) => (
      <meta {...tag} />
    ))}
    {posthogEnabled && <Analytics />}
  </head>
  <body class:list={[bodyBase, bodyClass]}>
    <slot />
  </body>
</html>
