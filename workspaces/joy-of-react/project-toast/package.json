{
  "name": "toast-component",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Josh Comeau <me@joshwcomeau.com>",
  "dependencies": {
    "new-component": "6.0.0",
    "process": "0.11.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-feather": "2.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cspell/dict-typescript": "catalog:",
    "@parcel/config-default": "catalog:",
    "cspell": "catalog:",
    "oxlint": "catalog:",
    "parcel": "catalog:",
    "parcel-reporter-static-files-copy": "catalog:",
    "rimraf": "catalog:"
  },
  "scripts": {
    "predev": "rimraf .parcel-cache dist",
    "dev": "parcel public/index.html",
    "build": "parcel build public/index.html",
    "new-component": "new-component",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "spell": "cspell --config ../../../.config/cspell.jsonc \"**\""
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "staticFiles": {
    "staticPath": "assets"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
