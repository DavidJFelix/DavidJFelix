{
  "name": "davidjfelix.com",
  "type": "module",
  "version": "0.0.1",
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "smoke": "bun bin/smoke-local.ts",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@davidjfelix/og": "workspace:*",
    "@davidjfelix/theme": "workspace:*",
    "@sentry/astro": "^10.60.0",
    "astro": "^7.3.0",
    "posthog-js": "^1.393.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "catalog:",
    "@sentry/cloudflare": "10.75.2",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "6.0.3",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
