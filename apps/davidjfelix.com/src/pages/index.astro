---
import {createThemeBootstrapScript} from '@davidjfelix/theme/bootstrap'
import Analytics from '../components/analytics.astro'
import ThemeToggle from '../components/theme-toggle.astro'

const title = 'David J. Felix'
const description = 'Personal site of David J. Felix.'

// Only ship analytics on builds that carry the key (production deploy). Sentry is
// injected separately by the @sentry/astro integration when PUBLIC_SENTRY_DSN is
// set. Both stay off locally/CI/preview.
const posthogEnabled = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY)

// Stringified at build time into the pre-paint inline script -- the only code
// that can run before first paint.
const themeBootstrapScript = createThemeBootstrapScript({storageKey: 'theme'})
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Pre-paint scheme bootstrap on the repo theming contract
        (docs/projects/theme-switcher-unification/plan.md), generated at
        build time from @davidjfelix/theme's typed bootstrap
        (packages/theme/src/bootstrap.ts). */}
    <script is:inline set:html={themeBootstrapScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {posthogEnabled && <Analytics />}
    <style>
      :root {
        /* light dark keeps the no-JS page following the OS; when JS runs the
           bootstrap pins the resolved scheme on the html style attribute and
           light-dark() follows it. Values are the zinc ramp: the dark column
           is the site's original palette, the light column mirrors it. */
        color-scheme: light dark;
        --bg: light-dark(#fafafa, #09090b);
        --fg: light-dark(#3f3f46, #e4e4e7);
        --muted: light-dark(#52525b, #a1a1aa);
        --accent: light-dark(#09090b, #f4f4f5);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
      }
      main {
        max-width: 36rem;
        text-align: left;
      }
      h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 1rem;
        color: var(--accent);
      }
      p {
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 2rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
      }
      a {
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid var(--muted);
        padding-bottom: 1px;
        transition: border-color 120ms ease;
      }
      a:hover { border-color: var(--accent); }
    </style>
  </head>
  <body>
    <ThemeToggle />
    <main>
      <h1>David J. Felix</h1>
      <p>Software engineer. This is my corner of the web.</p>
      <ul>
        <li><a href="https://djf.io">blog</a></li>
        <li><a href="https://github.com/davidjfelix">github</a></li>
      </ul>
    </main>
  </body>
</html>
