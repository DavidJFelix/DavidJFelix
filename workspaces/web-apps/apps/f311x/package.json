{
  "name": "@davidjfelix/f311x",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@davidjfelix/og": "workspace:*",
    "@davidjfelix/theme": "workspace:*",
    "@fontsource-variable/geist": "^5.2.9",
    "@sentry/cloudflare": "^10.60.0",
    "@sentry/react": "^10.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/ai": "^0.47.0",
    "@tanstack/ai-react": "^0.21.0",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "alchemy": "2.0.0-beta.72",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.111",
    "lucide-react": "^1.18.0",
    "marked": "^18.0.5",
    "posthog-js": "^1.393.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@effect/platform-node": "4.0.0-rc.111",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "catalog:",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "oxlint-tailwindcss": "1.10.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
