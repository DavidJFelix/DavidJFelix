{
  "name": "@davidjfelix/theme",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "exports": {
    ".": "./src/controller.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./schema": "./src/schema.ts",
    "./react": "./src/react.tsx",
    "./toggle": "./src/toggle.ts"
  },
  "scripts": {
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
