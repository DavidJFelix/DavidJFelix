{
  "name": "@davidjfelix/monicandavid.com",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#styled-system/*": {
      "types": "./styled-system/*/index.d.ts",
      "default": "./styled-system/*/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev --port 3003",
    "prepare": "svelte-kit sync && panda codegen",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.22.1",
    "@davidjfelix/og": "workspace:*",
    "@sentry/browser": "^11.0.0",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "mode-watcher": "^1.1.0",
    "posthog-js": "^1.393.0"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "oxlint-tsgolint": "catalog:",
    "svelte": "5.57.1",
    "svelte-check": "catalog:",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "3.1.0",
    "wrangler": "catalog:"
  }
}
