---
import {css} from 'styled-system/css'

// Padding grows the tap target past the WCAG 24px minimum; the negative
// margin keeps the icon's layout footprint unchanged in the header row (same
// pattern as the nav hamburger toggle in BaseLayout.astro).
const button = css({
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  p: '2',
  m: '-2',
  color: 'text.muted',
  bg: 'transparent',
  cursor: 'pointer',
  borderRadius: 'sm',
  _hover: {color: 'text'},
  _focusVisible: {outline: '[2px solid]', outlineColor: 'focus.ring', outlineOffset: '[2px]'},
})

// Icons are swapped by CSS from the raw data-theme-mode attribute BaseLayout's
// inline script sets on <html> before first paint, so the right icon (sun,
// moon, or monitor for system) shows immediately with no flash and no client
// JS state needed to pick it.
const onlyLightMode = css({display: 'none', '[data-theme-mode=light] &': {display: 'block'}})
const onlyDarkMode = css({display: 'none', '[data-theme-mode=dark] &': {display: 'block'}})
const onlySystemMode = css({display: 'none', '[data-theme-mode=system] &': {display: 'block'}})
---

<button type="button" id="theme-toggle" class={button} aria-label="Toggle color theme">
  <svg
    class={onlyLightMode}
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
  <svg
    class={onlyDarkMode}
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path
      d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
    ></path>
  </svg>
  <svg
    class={onlySystemMode}
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </svg>
</button>

<script>
  import {bindThemeToggle} from '@davidjfelix/theme/toggle'

  // Behavior (mode cycling, labels, live OS tracking, cross-tab sync) lives in
  // the package; this component owns only the markup and styling above.
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')
  if (toggle) bindThemeToggle(toggle)
</script>
