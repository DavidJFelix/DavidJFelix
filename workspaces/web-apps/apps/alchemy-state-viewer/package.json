{
  "name": "@davidjfelix/alchemy-state-viewer",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#styled-system/*": {
      "types": "./styled-system/*/index.d.ts",
      "default": "./styled-system/*/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev --port 3007",
    "prepare": "svelte-kit sync && panda codegen",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte": "5.57.1",
    "svelte-check": "catalog:",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.22.1",
    "@davidjfelix/og": "workspace:*",
    "mode-watcher": "^1.1.0"
  }
}
