{
  "name": "@davidjfelix/og",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "exports": {
    ".": "./src/tags.ts",
    "./image": "./src/image.ts"
  },
  "scripts": {
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@fontsource/inter": "^5.2.8",
    "satori": "^0.26.0 || ^0.29.0 || ^0.32.0 || ^0.33.0",
    "sharp": "^0.35.1"
  },
  "peerDependenciesMeta": {
    "@fontsource/inter": {
      "optional": true
    },
    "satori": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint-tsgolint": "7.0.2001",
    "satori": "0.33.3",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
