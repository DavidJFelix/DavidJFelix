{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revision-city-harness-opencode",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Without `workers_dev: false`, wrangler gives a Worker that has no route a
  // workers.dev host.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{"name": "REVIEW_AGENT", "class_name": "ReviewAgent"}],
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReviewAgent"]}],
  "observability": {
    "logs": {"enabled": true, "destinations": ["honeycomb-logs"]},
    "traces": {"enabled": true, "destinations": ["honeycomb-traces"]},
  },
}
