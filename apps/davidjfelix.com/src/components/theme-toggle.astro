---
// Tri-state color-scheme toggle on the repo theming contract
// (docs/projects/theme-switcher-unification/plan.md): cycles light -> dark ->
// system, persists to localStorage 'theme', and keeps <html>'s class,
// color-scheme, and data-theme-mode in step with the pre-paint bootstrap in
// index.astro. Icons swap purely in CSS from data-theme-mode, so the right
// one shows before this component's script loads.
---

<button type="button" id="theme-toggle" aria-label="Toggle color theme">
  <svg
    class="icon-light"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path
      d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
    ></path>
  </svg>
  <svg
    class="icon-dark"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
  <svg
    class="icon-system"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </svg>
</button>

<style>
  button {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms ease;
  }
  button:hover {
    color: var(--fg);
  }
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  svg {
    display: none;
  }
  :global(html[data-theme-mode='light']) .icon-light {
    display: block;
  }
  :global(html[data-theme-mode='dark']) .icon-dark {
    display: block;
  }
  :global(html[data-theme-mode='system']) .icon-system {
    display: block;
  }
</style>

<script>
  import * as z from 'zod/mini'

  // The repo theming contract's storage schema (see
  // docs/projects/theme-switcher-unification/plan.md): raw mode strings,
  // anything invalid parses to system. The pre-paint head script's literal
  // check is this schema's compiled twin -- it cannot import anything.
  const themeModeSchema = z.catch(z.enum(['light', 'dark', 'system']), 'system')
  type ThemeMode = z.infer<typeof themeModeSchema>

  // Cycle order: each press moves to the next mode, so all three states stay
  // reachable from a single button (system is never a dead end).
  const NEXT: Record<ThemeMode, ThemeMode> = {light: 'dark', dark: 'system', system: 'light'}

  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')

  function currentMode(): ThemeMode {
    return themeModeSchema.parse(document.documentElement.dataset.themeMode)
  }

  function updateLabel(mode: ThemeMode) {
    const label = `Switch to ${NEXT[mode]} theme`
    toggle?.setAttribute('aria-label', label)
    toggle?.setAttribute('title', label)
  }

  function apply(mode: ThemeMode) {
    const resolved =
      mode === 'system'
        ? matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
        : mode
    const root = document.documentElement
    root.classList.remove('light', 'dark')
    root.classList.add(resolved)
    root.style.colorScheme = resolved
    root.dataset.themeMode = mode
    updateLabel(mode)
  }

  function persist(mode: ThemeMode) {
    try {
      localStorage.setItem('theme', mode)
    } catch {
      // Storage may be unavailable (private mode / denied) -- non-fatal.
    }
  }

  updateLabel(currentMode())
  toggle?.addEventListener('click', () => {
    const next = NEXT[currentMode()]
    persist(next)
    apply(next)
  })
  // Track live OS changes while following the system, and other tabs' choices.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (currentMode() === 'system') apply('system')
  })
  window.addEventListener('storage', (event) => {
    if (event.key !== null && event.key !== 'theme') return
    let stored: string | null = null
    try {
      stored = localStorage.getItem('theme')
    } catch {
      // Unreadable storage keeps the current mode.
      return
    }
    apply(themeModeSchema.parse(stored))
  })
</script>
