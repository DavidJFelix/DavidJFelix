{
  "name": "@davidjfelix/monicandavid.com",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3003",
    "prepare": "svelte-kit sync && panda codegen",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.22.1",
    "@davidjfelix/og": "workspace:*",
    "@sentry/browser": "^10.60.0",
    "mode-watcher": "^1.1.0",
    "posthog-js": "^1.393.0"
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.123.0"
  }
}
