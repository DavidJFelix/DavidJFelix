{
  "name": "@davidjfelix/pkg.dog",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3004",
    "prepare": "nuxt prepare && panda codegen",
    "build": "panda codegen && nuxt build",
    "preview": "nuxt preview",
    "smoke": "bun bin/smoke-local.ts",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.2",
    "@davidjfelix/og": "workspace:*",
    "@sentry/browser": "^11.0.0",
    "h3": "^2.0.0",
    "nuxt": "^4.4.8",
    "posthog-js": "^1.393.0",
    "vue": "^3.5.38",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "4.0.1",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "6.0.3",
    "vitest": "catalog:",
    "vue-tsc": "3.3.12",
    "wrangler": "catalog:"
  }
}
