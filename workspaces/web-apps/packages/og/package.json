{
  "name": "@davidjfelix/og",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "exports": {
    ".": "./src/tags.ts",
    "./image": "./src/image.ts",
    "./card": "./src/card.ts",
    "./png": "./src/png.ts",
    "./runtime/node": "./src/runtime/node.ts",
    "./runtime/vite": {
      "types": "./src/runtime/vite.d.ts",
      "default": "./src/runtime/vite.ts"
    },
    "./runtime/nitro": {
      "types": "./src/runtime/nitro.d.ts",
      "default": "./src/runtime/nitro.ts"
    }
  },
  "scripts": {
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\"",
    "format:fix": "oxfmt . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "satori": "0.32.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}
