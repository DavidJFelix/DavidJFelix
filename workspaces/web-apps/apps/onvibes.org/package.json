{
  "name": "@davidjfelix/onvibes.org",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev",
    "dev:worker": "vite dev",
    "build": "bun run build:astro && bun run build:worker",
    "build:astro": "panda codegen && astro build",
    "build:worker": "vite build && bun bin/patch-flue-wrangler.ts",
    "preview": "astro preview",
    "smoke": "bun bin/smoke-local.ts",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "oxfmt --check . && biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "oxfmt . && biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.3",
    "@davidjfelix/og": "workspace:*",
    "@davidjfelix/theme": "workspace:*",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/react": "2.0.3",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@sentry/astro": "^10.60.0",
    "agents": "^0.21.0",
    "astro": "^7.0.0",
    "hono": "4.13.3",
    "posthog-js": "^1.393.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.4",
    "@cloudflare/vite-plugin": "1.53.1",
    "@flue/vite": "2.0.3",
    "@pandacss/dev": "1.12.0",
    "@playwright/test": "1.62.1",
    "@sentry/cloudflare": "10.70.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
